# --- Database (Neon PostgreSQL) -------------------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Session signing ------------------------------------------------------
# REQUIRED. Sign-in and registration are refused until this is set to a random
# string of at least 16 characters. Generate one with:
#   openssl rand -base64 32
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Environment variables are read at startup - restart the dev server after editing.
NEXTAUTH_SECRET=""

# --- Search provider ------------------------------------------------------
# "mock" runs the whole app on generated development data (no API credits).
# "google" uses the Google Programmable Search JSON API.
SEARCH_PROVIDER="mock"
SEARCH_API_KEY=""
SEARCH_ENGINE_ID=""

# --- Email verification (optional) ---------------------------------------
# Without a key, emails are reported as "Not checked" - never as valid.
EMAIL_VERIFICATION_API_KEY=""

# --- Free-tier spend guard -------------------------------------------------
# Hard ceiling on search API calls per provider quota day. One call returns 10
# results, so 100 calls = 1000 leads/day, which is exactly Google's free tier.
# Searches are refused once this is spent - nothing can be billed. Raise it
# only if you have deliberately accepted paid usage.
# SEARCH_DAILY_API_BUDGET=100
# Quota reset timezone (Google Custom Search resets at midnight Pacific).
# SEARCH_QUOTA_TIME_ZONE="America/Los_Angeles"
# Advanced: point the provider at a compatible endpoint (testing/proxying).
# SEARCH_API_ENDPOINT=""

# --- Optional limits and tuning (defaults shown) --------------------------
# MAX_SEARCHES_PER_DAY=10
# MAX_RESULTS_PER_SEARCH=100
# MAX_PAGES_PER_LEAD=5
# FETCH_TIMEOUT_MS=8000
# MAX_RESPONSE_BYTES=1500000
# CRAWL_DELAY_MS=250
# SEARCH_BATCH_SIZE=5

# --- Optional lead scoring weights (defaults shown) -----------------------
# SCORE_WEBSITE=15
# SCORE_EMAIL=25
# SCORE_PHONE=10
# SCORE_KEYWORD_MATCH=20
# SCORE_LOCATION_MATCH=10
# SCORE_CONTACT_PAGE=5
# SCORE_COMPANY=10
# SCORE_RELEVANT_SOURCE=5
