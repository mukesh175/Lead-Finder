# --- Database (Neon PostgreSQL) -------------------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Session signing ------------------------------------------------------
# Any random string of at least 16 characters: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Search provider ------------------------------------------------------
# "mock" runs the whole app on generated development data (no API credits).
# "google" uses the Google Programmable Search JSON API.
SEARCH_PROVIDER="mock"
SEARCH_API_KEY=""
SEARCH_ENGINE_ID=""

# --- Email verification (optional) ---------------------------------------
# Without a key, emails are reported as "Not checked" - never as valid.
EMAIL_VERIFICATION_API_KEY=""

# --- Optional limits and tuning (defaults shown) --------------------------
# MAX_SEARCHES_PER_DAY=10
# MAX_RESULTS_PER_SEARCH=100
# MAX_PAGES_PER_LEAD=5
# FETCH_TIMEOUT_MS=8000
# MAX_RESPONSE_BYTES=1500000
# CRAWL_DELAY_MS=250
# SEARCH_BATCH_SIZE=5

# --- Optional lead scoring weights (defaults shown) -----------------------
# SCORE_WEBSITE=15
# SCORE_EMAIL=25
# SCORE_PHONE=10
# SCORE_KEYWORD_MATCH=20
# SCORE_LOCATION_MATCH=10
# SCORE_CONTACT_PAGE=5
# SCORE_COMPANY=10
# SCORE_RELEVANT_SOURCE=5
