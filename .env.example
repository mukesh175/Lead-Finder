# --- Database (Neon PostgreSQL) -------------------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Session signing ------------------------------------------------------
# REQUIRED. Sign-in and registration are refused until this is set to a random
# string of at least 16 characters. Generate one with:
#   openssl rand -base64 32
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Environment variables are read at startup - restart the dev server after editing.
NEXTAUTH_SECRET=""

# --- Search provider ------------------------------------------------------
# mock   - generated development data, no account or credits needed (default)
# tavily - Tavily Search API      https://tavily.com      1,000 searches/month
# serper - Google results via Serper  https://serper.dev  2,500 free credits
# google - Google Programmable Search JSON API (CLOSED TO NEW CUSTOMERS since
#          2025; existing keys stop working 2027-01-01 - do not start here)
SEARCH_PROVIDER="mock"

# The API key for whichever provider is selected above.
SEARCH_API_KEY=""

# Only used by SEARCH_PROVIDER="google".
SEARCH_ENGINE_ID=""

# --- Phone verification (optional) ---------------------------------------
# Checks a number is real and active on a carrier - not that someone answers.
# abstract  = 250 lookups/month free   https://abstractapi.com
# numverify = 100 lookups/month free   https://numverify.com
PHONE_VERIFICATION_PROVIDER="abstract"
PHONE_VERIFICATION_API_KEY=""

# --- Email verification (optional) ---------------------------------------
# Without a key, emails are reported as "Not checked" - never as valid.
EMAIL_VERIFICATION_API_KEY=""

# --- Free-tier spend guard -------------------------------------------------
# Each provider defaults to the free allowance its vendor grants, and searches
# are refused once it is spent - so nothing can be billed:
#   tavily 1,000 calls/month | serper 2,500 calls/month | google 100 calls/day
# Override only if you have deliberately accepted paid usage.
# SEARCH_API_BUDGET=1000
# SEARCH_API_BUDGET_PERIOD="month"   # "day" or "month"
# Timezone the allowance resets in.
# SEARCH_QUOTA_TIME_ZONE="America/Los_Angeles"
# Advanced: point a provider at a compatible endpoint (testing/proxying).
# SEARCH_API_ENDPOINT=""
# TAVILY_API_ENDPOINT=""
# SERPER_API_ENDPOINT=""

# --- Optional limits and tuning (defaults shown) --------------------------
# MAX_SEARCHES_PER_DAY=10
# MAX_RESULTS_PER_SEARCH=100
# MAX_PAGES_PER_LEAD=5
# FETCH_TIMEOUT_MS=8000
# MAX_RESPONSE_BYTES=1500000
# CRAWL_DELAY_MS=250
# SEARCH_BATCH_SIZE=5

# --- Optional lead scoring weights (defaults shown) -----------------------
# SCORE_WEBSITE=15
# SCORE_EMAIL=25
# SCORE_PHONE=10
# SCORE_KEYWORD_MATCH=20
# SCORE_LOCATION_MATCH=10
# SCORE_CONTACT_PAGE=5
# SCORE_COMPANY=10
# SCORE_RELEVANT_SOURCE=5
